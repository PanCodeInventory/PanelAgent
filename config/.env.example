# PanelAgent - LLM settings template

# Copy this file to `config/.env` and fill in your real values.
#   cp config/.env.example config/.env

# OpenAI-compatible API endpoint (e.g. DeepSeek, OpenAI, local LM Studio).
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_MODEL_NAME=deepseek-chat

# Admin login password and session signing secret.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-session-secret

# Comma-separated list of allowed CORS origins for the backend.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
